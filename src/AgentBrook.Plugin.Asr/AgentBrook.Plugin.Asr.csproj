<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="sample.wav" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约（宿主加载，回退共享） -->
    <ProjectReference Include="..\AgentBrook.Plugin.Abstractions\AgentBrook.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件私有依赖（随插件包分发，AssemblyDependencyResolver 从插件目录解析；
         sherpa-onnx NuGet 自带 runtimes/{rid}/native 声明，native 由 PluginLoadContext 解析） -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
  </ItemGroup>

</Project>
