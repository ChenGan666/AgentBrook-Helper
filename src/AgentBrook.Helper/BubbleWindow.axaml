<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AgentBrook.Helper.BubbleWindow"
        Title="Brook"
        Icon="avares://AgentBrook.Helper/Assets/app-icon.png"
        Width="240" Height="330"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False">

    <!-- 布局：气泡顶部居中下移 24px（给轨道环留出窗口内空间，避免图标被上边缘裁剪），
         气泡圆心 = (120, 72)；轨道图标绕此圆心静态排布（按启动顺序均分圆）；
         提示卡在气泡下方。加大的窗口区域透明且不参与命中，不挡桌面点击。 -->
    <Panel>
        <!-- 工具/子Agent 轨道层：与气泡同位（96x96，画布内圆心 48,48 即气泡圆心），无任何变换 -->
        <Canvas x:Name="OrbitLayer" Width="96" Height="96"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                IsHitTestVisible="False"/>

        <!-- 气泡本体（原 96x96 结构不动，顶部居中下移 24px） -->
        <Panel x:Name="Root" Width="96" Height="96"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <!-- 外圈光晕（呼吸动画；83x83，比主体大，留在气泡区内不裁剪） -->
            <Ellipse x:Name="GlowOuter" Width="83" Height="83"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="#4a9eff" Opacity="0.22">
                <Ellipse.Styles>
                    <Style Selector="Ellipse">
                        <Style.Animations>
                            <Animation Duration="0:0:1.8" IterationCount="Infinite" PlaybackDirection="Alternate"
                                       Easing="SineEaseInOut">
                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.12"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.38"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Ellipse.Styles>
            </Ellipse>

            <!-- 主体圆 70x70，同心 -->
            <Ellipse x:Name="Body" Width="70" Height="70"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="60%,100%">
                        <GradientStop Color="#6bb9ff" Offset="0"/>
                        <GradientStop Color="#2f7bff" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>


            <!-- 工作呼吸层：半透明白膜随思考起伏（Thinking/CallingTool 时可见） -->
            <Ellipse x:Name="WorkOverlay" Width="70" Height="70"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="#40ffffff" IsVisible="False">
                <Ellipse.Styles>
                    <Style Selector="Ellipse">
                        <Style.Animations>
                            <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate"
                                       Easing="SineEaseInOut">
                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.10"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Ellipse.Styles>
            </Ellipse>

            <!-- 中心图标（状态切换）。用 Path 而非 PathIcon：Avalonia 12 的 PathIcon 会无视
                 RenderTransform 的 CenterX/CenterY（等效绕 0,0 转），齿轮自转会偏轴 -->
            <Path x:Name="BubbleIcon" Width="27" Height="27"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="#ffffff" Stretch="Uniform"/>
        </Panel>

        <!-- 提示卡堆（问候语 / 审批快捷操作 / 提问提醒），气泡下方 -->
        <StackPanel x:Name="ToastPanel" Width="228" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,140,0,0"/>
    </Panel>
</Window>
