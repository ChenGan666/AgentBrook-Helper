<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AgentBrook.Helper.ModelSettingsWindow"
        RequestedThemeVariant="Dark"
        Title="设置" Width="920" Height="680" MinWidth="760" MinHeight="560"
        Icon="avares://AgentBrook.Helper/Assets/app-icon.png"
        Background="#1f1f1f"
        FontFamily="PingFang SC, Hiragino Sans GB, Microsoft YaHei">

    <Window.Styles>
        <!-- 左侧导航项（RadioButton 重模板为导航条目） -->
        <Style Selector="RadioButton.navItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c8c8c8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.navItem:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="Foreground" Value="#f0f0f0"/>
        </Style>
        <Style Selector="RadioButton.navItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2e2e2e"/>
        </Style>
        <Style Selector="TextBlock.navGroup">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#7a7a7a"/>
            <Setter Property="Margin" Value="10,14,0,4"/>
        </Style>

        <Style Selector="Button.presetBtn">
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.presetBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#383838"/>
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="#2f7bff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.ghostBtn">
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.ghostBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#383838"/>
        </Style>
        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ff7a70"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#6b3a35"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.formLabel">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#9a9a9a"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#f0f0f0"/>
        </Style>
        <Style Selector="TextBlock.pageDesc">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8a8a8a"/>
        </Style>
        <Style Selector="ListBox.providerList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="190,*">

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#232323" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="10,18,10,10">
                    <TextBlock x:Name="NavGroupBasic" Text="基础设置" Classes="navGroup"/>
                    <RadioButton x:Name="NavGeneral" Classes="navItem" GroupName="nav" IsChecked="True">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Settings}" Width="15" Height="15"/>
                            <TextBlock x:Name="NavGeneralText" Text="常规"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAppearance" Classes="navItem" GroupName="nav" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Sparkle}" Width="15" Height="15"/>
                            <TextBlock x:Name="NavAppearanceText" Text="外观"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="NavGroupModels" Text="模型" Classes="navGroup"/>
                    <RadioButton x:Name="NavModels" Classes="navItem" GroupName="nav">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Swap}" Width="15" Height="15"/>
                            <TextBlock x:Name="NavModelsText" Text="模型设置"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="NavGroupAgent" Text="智能体" Classes="navGroup"/>
                    <RadioButton x:Name="NavSkills" Classes="navItem" GroupName="nav">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Book}" Width="15" Height="15"/>
                            <TextBlock x:Name="NavSkillsText" Text="Skill管理"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧内容区（内容超高时可纵向滚动，如常规页的自启动/提示音区块） -->
        <ScrollViewer Grid.Column="1" Margin="26,20,26,16" HorizontalScrollBarVisibility="Disabled">
        <Panel>

            <!-- 常规 -->
            <StackPanel x:Name="PageGeneral" IsVisible="False" Spacing="6">
                <TextBlock x:Name="GeneralTitle" Text="常规" Classes="pageTitle"/>
                <TextBlock x:Name="GeneralDesc" Text="助手身份与交流偏好。" Classes="pageDesc" Margin="0,2,0,14"/>

                <TextBlock x:Name="LabelWorkspace" Text="主工作空间" Classes="formLabel"/>
                <TextBlock x:Name="WorkspaceDesc" Text="智能体的文件、脚本与记忆所在目录；修改保存后重启应用生效，助手设置随工作空间保存" Classes="pageDesc" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="WorkspaceBox" Width="380" FontSize="13"/>
                    <Button x:Name="WorkspacePickBtn" Classes="ghostBtn" Content="选择目录…"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button x:Name="WorkspaceSaveBtn" Classes="primaryBtn" Content="保存工作空间"/>
                    <Button x:Name="WorkspaceResetBtn" Classes="ghostBtn" Content="恢复默认"/>
                    <TextBlock x:Name="WorkspaceHint" Text="" FontSize="12" Foreground="#8a8a8a" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Separator Margin="0,14,0,10" Background="#333333"/>
                <TextBlock x:Name="LabelAssistantName" Text="助手名字" Classes="formLabel"/>
                <TextBox x:Name="PersonalNameBox" Watermark="Brook" FontSize="14" MaxWidth="380"
                         HorizontalAlignment="Left"/>
                <TextBlock x:Name="LabelReplyLang" Text="交流语言（影响模型回复语言）" Classes="formLabel"/>
                <ComboBox x:Name="LanguageBox" FontSize="13.5" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
                <TextBlock x:Name="LabelUiLang" Text="界面语言（UI 显示；切换后重启应用完全生效）" Classes="formLabel"/>
                <ComboBox x:Name="UiLanguageBox" FontSize="13.5" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
                    <ComboBoxItem Content="跟随系统" Tag="auto"/>
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
                <TextBlock x:Name="LabelCustomPrompt" Text="默认提示词（附加到系统指令，每轮生效）" Classes="formLabel"/>
                <TextBox x:Name="CustomPromptBox" Watermark="例如：回答尽量简短；优先用表格展示数据…" FontSize="13.5"
                         Height="72" TextWrapping="Wrap" AcceptsReturn="True"/>
                <Button x:Name="SavePersonalBtn" Classes="primaryBtn" Content="保存常规设置"
                        HorizontalAlignment="Left" Margin="0,14,0,0"/>
                <TextBlock x:Name="PersonalHint" Text="" FontSize="12.5" Foreground="#8a8a8a"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>

                <Separator Margin="0,16,0,8" Background="#333333"/>
                <TextBlock x:Name="LabelAutoStart" Text="开机自启动" Classes="formLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ToggleSwitch x:Name="AutoStartSwitch" MinWidth="0" OnContent="" OffContent=""/>
                    <TextBlock x:Name="AutoStartDesc" Text="登录系统后自动启动，气泡常驻待命" FontSize="12.5"
                               Foreground="#8a8a8a" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="AutoStartHint" Text="" FontSize="12" Foreground="#8a8a8a"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                <Separator Margin="0,16,0,8" Background="#333333"/>
                <TextBlock x:Name="LabelNotifySound" Text="提示音" Classes="formLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ToggleSwitch x:Name="NotifySoundSwitch" MinWidth="0" OnContent="" OffContent=""/>
                    <ComboBox x:Name="NotifySoundBox" FontSize="13" Width="120" VerticalAlignment="Center">
                        <ComboBoxItem Content="叮" Tag="ding"/>
                        <ComboBoxItem Content="玻璃" Tag="glass"/>
                        <ComboBoxItem Content="和弦" Tag="hero"/>
                    </ComboBox>
                    <TextBlock x:Name="NotifySoundDesc" Text="任务完成且对话窗不在前台时播放" FontSize="12.5"
                               Foreground="#8a8a8a" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Margin="0,16,0,8" Background="#333333"/>
                <TextBlock x:Name="LabelUpdate" Text="版本更新" Classes="formLabel"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <TextBlock x:Name="LabelUpdateServiceUrl" Text="更新服务地址" Classes="formLabel"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="UpdateServiceUrlBox" Width="260" FontSize="13"
                             Watermark="http://helper.agentbrook.com"/>
                    <Button x:Name="SaveUpdateUrlBtn" Classes="ghostBtn" Content="保存地址"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <TextBlock x:Name="CurrentVersionText" Text="当前版本：—" FontSize="12.5"
                               Foreground="#9a9a9a" VerticalAlignment="Center"/>
                    <Button x:Name="CheckUpdateBtn" Classes="ghostBtn" Content="检查更新"/>
                    <Button x:Name="UpgradeBtn" Classes="primaryBtn" Content="立即升级" IsVisible="False"/>
                </StackPanel>
                <TextBlock x:Name="UpdateHint" Text="" FontSize="12" Foreground="#8a8a8a"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                <StackPanel x:Name="UpdateProgressPanel" Orientation="Horizontal" Spacing="10" IsVisible="False"
                            Margin="0,4,0,0">
                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" Width="200"
                                 Height="8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateProgressText" Text="0%" FontSize="12.5" Foreground="#9a9a9a"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="UpdateDetailsPanel" IsVisible="False" Background="#252525" CornerRadius="12"
                        Padding="12" BorderBrush="#333333" BorderThickness="1" Margin="0,6,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="UpdatePlatformText" FontSize="12.5" Foreground="#9a9a9a"/>
                        <TextBlock x:Name="UpdateFileInfoText" FontSize="12.5" Foreground="#9a9a9a"/>
                        <TextBlock x:Name="UpdateReleaseNotesTitle" Text="更新说明" FontSize="12.5"
                                   Foreground="#f0f0f0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UpdateReleaseNotesText" FontSize="12.5" Foreground="#9a9a9a"
                                   TextWrapping="Wrap" MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 外观 -->
            <StackPanel x:Name="PageAppearance" IsVisible="False" Spacing="6">
                <TextBlock x:Name="AppearanceTitle" Text="外观" Classes="pageTitle"/>
                <TextBlock x:Name="AppearanceDesc" Text="悬浮气泡的个性化显示。" Classes="pageDesc" Margin="0,2,0,14"/>

                <TextBlock x:Name="LabelBubbleIcon" Text="气泡图标" Classes="formLabel"/>
                <WrapPanel x:Name="IconPicker" MaxWidth="300" HorizontalAlignment="Left"/>
                <Separator Margin="0,14,0,6" Background="#333333"/>
                <TextBlock x:Name="LabelBubblePos" Text="气泡位置" Classes="formLabel"/>
                <Button x:Name="ResetPosBtn" Classes="ghostBtn" Content="重置到默认位置（右上角）"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- 模型设置 -->
            <StackPanel x:Name="PageModels" Spacing="6">
                <TextBlock x:Name="ModelsTitle" Text="模型设置" Classes="pageTitle"/>
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,12">
                    <TextBlock Grid.Column="0" x:Name="ModelsDesc" Text="管理模型供应商，配置后即可在底部切换使用。" Classes="pageDesc"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="SaveApplyBtn" Classes="primaryBtn" Content="保存并应用" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="CloseBtn" Classes="ghostBtn" Content="关闭"/>
                </Grid>
                <Grid ColumnDefinitions="230,*,240" ColumnSpacing="14">
                    <Border Grid.Column="0" Background="#252525" CornerRadius="12" Padding="8"
                            BorderBrush="#333333" BorderThickness="1">
                        <Grid RowDefinitions="*,Auto">
                            <ListBox Grid.Row="0" x:Name="ProviderList" Classes="providerList" Height="360"/>
                            <Button Grid.Row="1" x:Name="AddBtn" Classes="ghostBtn" Content="＋ 添加供应商"
                                    HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#252525" CornerRadius="12" Padding="18,14"
                            BorderBrush="#333333" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel x:Name="FormPanel" Spacing="2" IsEnabled="False">
                                <TextBlock x:Name="LabelProviderName" Text="供应商名称" Classes="formLabel"/>
                                <TextBox x:Name="NameBox" FontSize="14"/>
                                <TextBlock x:Name="LabelApiEndpoint" Text="API 地址（OpenAI 兼容端点）" Classes="formLabel"/>
                                <TextBox x:Name="BaseUrlBox" Watermark="https://api.deepseek.com/v1" FontSize="14"/>
                                <TextBlock x:Name="LabelApiKey" Text="API Key" Classes="formLabel"/>
                                <TextBox x:Name="ApiKeyBox" Watermark="sk-..." FontSize="14"/>
                                <TextBlock x:Name="LabelModelsCsv" Text="模型清单（逗号分隔，第一个为默认）" Classes="formLabel"/>
                                <TextBox x:Name="ModelsBox" Watermark="model-a, model-b" FontSize="14" Height="64"
                                         TextWrapping="Wrap" AcceptsReturn="True"/>
                                <Button x:Name="DeleteBtn" Classes="dangerBtn" Content="删除此供应商" Margin="0,18,0,0"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Background="#252525" CornerRadius="12" Padding="10"
                            BorderBrush="#333333" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel x:Name="PresetPanel" Spacing="6">
                                <TextBlock x:Name="PresetHeader" Text="快速添加（点选模板）" FontSize="12" Foreground="#8a8a8a" Margin="4,2,0,6"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Skill 管理 -->
            <StackPanel x:Name="PageSkills" IsVisible="False" Spacing="6">
                <TextBlock x:Name="SkillsTitle" Text="Skill管理" Classes="pageTitle"/>
                <TextBlock x:Name="SkillsDesc" Text="管理已安装的技能，删除后立即生效。"
                           Classes="pageDesc" Margin="0,2,0,14"/>
                <Border Background="#252525" CornerRadius="12" Padding="12"
                        BorderBrush="#333333" BorderThickness="1">
                    <ScrollViewer MaxHeight="420">
                        <StackPanel x:Name="SkillsListPanel" Spacing="8"/>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="SkillsHint" Text="" FontSize="12.5" Foreground="#8a8a8a"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Panel>
        </ScrollViewer>
    </Grid>
</Window>
