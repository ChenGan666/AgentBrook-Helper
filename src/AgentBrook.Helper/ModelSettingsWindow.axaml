<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AgentBrook.Helper.ModelSettingsWindow"
        RequestedThemeVariant="Dark"
        Title="设置" Width="920" Height="680" MinWidth="760" MinHeight="560"
        Background="#1f1f1f"
        FontFamily="PingFang SC, Hiragino Sans GB, Microsoft YaHei"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Styles>
        <!-- 左侧导航项（RadioButton 重模板为导航条目） -->
        <Style Selector="RadioButton.navItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c8c8c8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.navItem:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="Foreground" Value="#f0f0f0"/>
        </Style>
        <Style Selector="RadioButton.navItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2e2e2e"/>
        </Style>
        <Style Selector="TextBlock.navGroup">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#7a7a7a"/>
            <Setter Property="Margin" Value="10,14,0,4"/>
        </Style>

        <Style Selector="Button.presetBtn">
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.presetBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#383838"/>
        </Style>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="#2f7bff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.ghostBtn">
            <Setter Property="Background" Value="#2b2b2b"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.ghostBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#383838"/>
        </Style>
        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ff7a70"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#6b3a35"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.formLabel">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#9a9a9a"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#f0f0f0"/>
        </Style>
        <Style Selector="TextBlock.pageDesc">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8a8a8a"/>
        </Style>
        <Style Selector="ListBox.providerList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="190,*">

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#232323" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="10,18,10,10">
                    <TextBlock Text="基础设置" Classes="navGroup"/>
                    <RadioButton x:Name="NavGeneral" Classes="navItem" GroupName="nav" IsChecked="True">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Settings}" Width="15" Height="15"/>
                            <TextBlock Text="常规"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAppearance" Classes="navItem" GroupName="nav" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Sparkle}" Width="15" Height="15"/>
                            <TextBlock Text="外观"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="模型" Classes="navGroup"/>
                    <RadioButton x:Name="NavModels" Classes="navItem" GroupName="nav">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Swap}" Width="15" Height="15"/>
                            <TextBlock Text="模型设置"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧内容区 -->
        <Panel Grid.Column="1" Margin="26,20,26,16">

            <!-- 常规 -->
            <StackPanel x:Name="PageGeneral" IsVisible="False" Spacing="6">
                <TextBlock Text="常规" Classes="pageTitle"/>
                <TextBlock Text="助手身份与交流偏好。" Classes="pageDesc" Margin="0,2,0,14"/>

                <TextBlock Text="助手名字" Classes="formLabel"/>
                <TextBox x:Name="PersonalNameBox" Watermark="Brook" FontSize="14" MaxWidth="380"
                         HorizontalAlignment="Left"/>
                <TextBlock Text="交流语言（影响模型回复语言）" Classes="formLabel"/>
                <ComboBox x:Name="LanguageBox" FontSize="13.5" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
                    <ComboBoxItem Content="中文"/>
                    <ComboBoxItem Content="English"/>
                </ComboBox>
                <TextBlock Text="默认提示词（附加到系统指令，每轮生效）" Classes="formLabel"/>
                <TextBox x:Name="CustomPromptBox" Watermark="例如：回答尽量简短；优先用表格展示数据…" FontSize="13.5"
                         Height="72" TextWrapping="Wrap" AcceptsReturn="True"/>
                <Button x:Name="SavePersonalBtn" Classes="primaryBtn" Content="保存常规设置"
                        HorizontalAlignment="Left" Margin="0,14,0,0"/>
                <TextBlock x:Name="PersonalHint" Text="" FontSize="12.5" Foreground="#8a8a8a"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 外观 -->
            <StackPanel x:Name="PageAppearance" IsVisible="False" Spacing="6">
                <TextBlock Text="外观" Classes="pageTitle"/>
                <TextBlock Text="悬浮气泡的个性化显示。" Classes="pageDesc" Margin="0,2,0,14"/>

                <TextBlock Text="气泡图标" Classes="formLabel"/>
                <WrapPanel x:Name="IconPicker" MaxWidth="300" HorizontalAlignment="Left"/>
                <Separator Margin="0,14,0,6" Background="#333333"/>
                <TextBlock Text="气泡位置" Classes="formLabel"/>
                <Button x:Name="ResetPosBtn" Classes="ghostBtn" Content="重置到默认位置（右上角）"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- 模型设置 -->
            <StackPanel x:Name="PageModels" Spacing="6">
                <TextBlock Text="模型设置" Classes="pageTitle"/>
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,12">
                    <TextBlock Grid.Column="0" Text="管理模型供应商，配置后即可在底部切换使用。" Classes="pageDesc"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="SaveApplyBtn" Classes="primaryBtn" Content="保存并应用" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="CloseBtn" Classes="ghostBtn" Content="关闭"/>
                </Grid>
                <Grid ColumnDefinitions="230,*,240" ColumnSpacing="14">
                    <Border Grid.Column="0" Background="#252525" CornerRadius="12" Padding="8"
                            BorderBrush="#333333" BorderThickness="1">
                        <Grid RowDefinitions="*,Auto">
                            <ListBox Grid.Row="0" x:Name="ProviderList" Classes="providerList" Height="360"/>
                            <Button Grid.Row="1" x:Name="AddBtn" Classes="ghostBtn" Content="＋ 添加供应商"
                                    HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#252525" CornerRadius="12" Padding="18,14"
                            BorderBrush="#333333" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel x:Name="FormPanel" Spacing="2" IsEnabled="False">
                                <TextBlock Text="供应商名称" Classes="formLabel"/>
                                <TextBox x:Name="NameBox" FontSize="14"/>
                                <TextBlock Text="API 地址（OpenAI 兼容端点）" Classes="formLabel"/>
                                <TextBox x:Name="BaseUrlBox" Watermark="https://api.deepseek.com/v1" FontSize="14"/>
                                <TextBlock Text="API Key" Classes="formLabel"/>
                                <TextBox x:Name="ApiKeyBox" Watermark="sk-..." FontSize="14"/>
                                <TextBlock Text="模型清单（逗号分隔，第一个为默认）" Classes="formLabel"/>
                                <TextBox x:Name="ModelsBox" Watermark="model-a, model-b" FontSize="14" Height="64"
                                         TextWrapping="Wrap" AcceptsReturn="True"/>
                                <Button x:Name="DeleteBtn" Classes="dangerBtn" Content="删除此供应商" Margin="0,18,0,0"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Background="#252525" CornerRadius="12" Padding="10"
                            BorderBrush="#333333" BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel x:Name="PresetPanel" Spacing="6">
                                <TextBlock Text="快速添加（点选模板）" FontSize="12" Foreground="#8a8a8a" Margin="4,2,0,6"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </StackPanel>
        </Panel>
    </Grid>
</Window>
