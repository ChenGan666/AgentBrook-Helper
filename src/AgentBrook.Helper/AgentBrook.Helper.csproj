<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBrook.Helper</RootNamespace>
    <Description>AgentBrook.Helper —— 跨平台桌面客户端（Avalonia，macOS/Windows）：语音优先，复用 AgentBrook.Agent.Core。</Description>
    <!-- 文件属性元数据（Windows 资源管理器/杀软信誉参考；契约：公司=主体全称，产品/标题保持英文品牌名） -->
    <Company>福州知数能信息科技有限责任公司</Company>
    <Product>AgentBrook Helper</Product>
    <AssemblyTitle>AgentBrook Helper</AssemblyTitle>
    <Copyright>Copyright © 2026 福州知数能信息科技有限责任公司</Copyright>
    <!-- Windows 可执行文件图标（macOS 走 build-mac-app.sh 打包的 .icns） -->
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentBrook.Helper.Im.Tests" />
    <InternalsVisibleTo Include="AgentBrook.Helper.Voice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="publish\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标（axaml 里以 avares:// 引用） -->
    <AvaloniaResource Include="Assets/app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- 语音音频前端（doc/Voice/01 B2）：Telegram voice = Ogg 封装 Opus，本地引擎/降级上传需解码为 16k PCM -->
    <PackageReference Include="Concentus.OggFile" Version="1.0.7" />
    <ProjectReference Include="..\AgentBrook.Agent.Core\AgentBrook.Agent.Core.csproj" />
    <ProjectReference Include="..\AgentBrook.Runtime.Abstractions\AgentBrook.Runtime.Abstractions.csproj" />
    <ProjectReference Include="..\AgentBrook.Runtime\AgentBrook.Runtime.csproj" />
    <ProjectReference Include="..\AgentBrook.Messaging.Abstractions\AgentBrook.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\AgentBrook.Messaging\AgentBrook.Messaging.csproj" />
    <ProjectReference Include="..\AgentBrook.Agent.IM\AgentBrook.Agent.IM.csproj" />
    <ProjectReference Include="..\AgentBrook.Plugin.Hosting.Abstractions\AgentBrook.Plugin.Hosting.Abstractions.csproj" />
    <ProjectReference Include="..\AgentBrook.Plugin.Hosting\AgentBrook.Plugin.Hosting.csproj" />
    <ProjectReference Include="..\AgentBrook.Plugin.Abstractions\AgentBrook.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="release-notes.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="scripts\stt.swift" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBrook.A2A.Core\AgentBrook.A2A.Core.csproj" />
    <ProjectReference Include="..\AgentBrook.A2A.Transport\AgentBrook.A2A.Transport.csproj" />
  </ItemGroup>

</Project>
