<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约（宿主加载，回退共享） -->
    <ProjectReference Include="..\AgentBrook.Plugin.Abstractions\AgentBrook.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件私有依赖（随插件包分发，AssemblyDependencyResolver 从插件目录解析）。
         sherpa-onnx 必须与 ASR 插件锁步 2.0.1（doc/19 红线 6：同进程原生运行时版本唯一；
         打包脚本改名 ort_tts.dll / libonnxruntime-tts.dylib 隔离 + TtsPlugin 启动预载）。
         NAudio 仅 Windows 播放端使用（managed，与 Helper 同版本）。 -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
